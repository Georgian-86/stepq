{
  "name": "stepq",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:preview": "pnpm --filter web exec playwright test -c playwright.preview.config.ts",
    "format": "prettier --write .",
    "emulators": "firebase emulators:exec --project demo-stepq",
    "emulators:unit": "firebase emulators:exec --project demo-stepq --only firestore,storage",
    "check:launch": "tsx scripts/check-launch.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^14.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "3.2.7"
  }
}
