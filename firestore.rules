rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything by default. All writes go through callable Functions
    // (Admin SDK bypasses these rules).
    match /{document=**} {
      allow read, write: if false;
    }

    // Public, server-maintained aggregates: single-document reads only.
    match /public/{doc} {
      allow get: if doc in ['stats', 'backers'];
    }
  }
}
